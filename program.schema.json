{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Program",
  "description": "One compiled machine run for one board (PROGRAM_FORMAT.md). Rules V4, V5, V7, V8 and V10\nneed code beyond its types and schema.",
  "type": "object",
  "properties": {
    "board": {
      "$ref": "#/$defs/Board"
    },
    "format": {
      "type": "string",
      "const": "601rs-program"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "material": {
      "$ref": "#/$defs/Material"
    },
    "meta": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "ops": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Op"
      },
      "minItems": 1
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "const": 1,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "board",
    "material",
    "ops"
  ],
  "$defs": {
    "BladeOffsets": {
      "type": "object",
      "properties": {
        "bevel": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "bevel_round": {
          "description": "The bevel head's trim on closed curves (GMC's `ZCorrection_Round`); `bevel` if absent.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "straight": {
          "type": "number",
          "format": "double",
          "default": 0.0
        }
      },
      "additionalProperties": false
    },
    "Board": {
      "type": "object",
      "properties": {
        "height_mm": {
          "type": "number",
          "format": "double",
          "exclusiveMinimum": 0
        },
        "thickness_mm": {
          "type": "number",
          "format": "double",
          "exclusiveMinimum": 0
        },
        "width_mm": {
          "type": "number",
          "format": "double",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "width_mm",
        "height_mm",
        "thickness_mm"
      ]
    },
    "ClampSide": {
      "type": "string",
      "enum": [
        "left",
        "right",
        "both",
        "none"
      ]
    },
    "Head": {
      "type": "string",
      "enum": [
        "straight",
        "bevel"
      ]
    },
    "Material": {
      "type": "object",
      "properties": {
        "blade_angle_offset_deg": {
          "$ref": "#/$defs/BladeOffsets",
          "default": {
            "bevel": 0.0,
            "straight": 0.0
          }
        },
        "head_settle_ms": {
          "type": "integer",
          "format": "uint32",
          "maximum": 5000,
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "speed_pct": {
          "type": "number",
          "format": "double",
          "maximum": 100,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "speed_pct",
        "head_settle_ms"
      ]
    },
    "Op": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "label": {
              "type": [
                "string",
                "null"
              ]
            },
            "op": {
              "type": "string",
              "const": "clamp"
            },
            "side": {
              "$ref": "#/$defs/ClampSide"
            },
            "turned": {
              "description": "The clamp pads the operator turns out of the way for the cuts that follow, by the\nmachine profile's names (`F3`, `L1`): those cuts may run over them (§4.1).",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "side"
          ]
        },
        {
          "type": "object",
          "properties": {
            "head": {
              "$ref": "#/$defs/Head"
            },
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "label": {
              "type": [
                "string",
                "null"
              ]
            },
            "op": {
              "type": "string",
              "const": "cut"
            },
            "path_mm": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "double"
                },
                "maxItems": 2,
                "minItems": 2
              },
              "minItems": 2
            },
            "speed_pct": {
              "type": [
                "number",
                "null"
              ],
              "format": "double",
              "maximum": 100,
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "head",
            "path_mm"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "label": {
              "type": [
                "string",
                "null"
              ]
            },
            "op": {
              "type": "string",
              "const": "move"
            },
            "to_mm": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "maxItems": 2,
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "to_mm"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "label": {
              "type": [
                "string",
                "null"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "op": {
              "type": "string",
              "const": "pause"
            },
            "resume": {
              "$ref": "#/$defs/Resume"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "message",
            "resume"
          ]
        }
      ]
    },
    "Resume": {
      "type": "string",
      "enum": [
        "start_button",
        "operator"
      ]
    }
  }
}
